provider: lmstudio          # lmstudio | ollama | anthropic | openai
model: qwen3-8b
base_url: http://localhost:1234/v1   # required for lmstudio/ollama
base_resume: resumes/backend.md
output_dir: output/

pdf:
  theme: "modernblue"       # or "classic", "sleektech", etc.
  engine: jsonresume        # or "rendercv"

search:
  keywords: "backend engineer python"
  location: "Remote"
  remote: true
  results_wanted: 20
  min_salary: 100000        # optional
  job_type: "fulltime"      # optional
  exclude_companies:        # optional
    - "Acme Corp"
  exclude_keywords:         # optional
    - "US Citizen"
    - "Clearance"
  proxies:                  # optional
    - "http://user:pass@host:port"
